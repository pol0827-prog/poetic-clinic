# 로컬 개발(npm run dev)할 때만 필요해요.
# Firebase Hosting 에 배포하면 이 값 없이도 자동으로 설정을 불러와요.
# 이 파일을 .env 로 복사한 뒤 Firebase 콘솔 > 프로젝트 설정 > 내 앱 > SDK 설정 값을 붙여 넣으세요.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# 에뮬레이터로 테스트할 때 true
VITE_USE_EMULATORS=false

# ※ Google AI Studio(Gemini) 키는 여기에 넣지 마세요!
#   firebase functions:secrets:set GEMINI_API_KEY 로 서버에만 저장합니다.
